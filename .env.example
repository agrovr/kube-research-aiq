# Copy to .env. Everything is optional: without keys, dives run offline against the
# bundled reference library and every report is assembled from the sources it cites.

# Models: "mock" (offline) or "nvidia" (any OpenAI-compatible endpoint).
KRAI_PROVIDER=mock
KRAI_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
KRAI_NVIDIA_API_KEY=
KRAI_SHALLOW_MODEL=nvidia/nemotron-3-nano-30b-a3b
KRAI_DEEP_MODEL=openai/gpt-oss-120b
KRAI_CLASSIFIER_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Live web search alongside the library.
KRAI_TAVILY_API_KEY=

# Storage and queue. Leave empty to use a local JSON file and run dives in the API.
KRAI_REDIS_URL=redis://localhost:6379/0
KRAI_DATABASE_URL=postgresql://krai:krai-dev-password@localhost:5432/krai

# Offline demos: pause between stages so the dashboard shows the dive.
KRAI_MOCK_LATENCY_SECONDS=0
KRAI_CORS_ORIGINS=*
